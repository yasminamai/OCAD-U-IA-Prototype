      label: s.label + (s.external ? "  ↗" : ""),
      arrow: s.arrow,
      go: s.go,
      style: "display:flex; align-items:center; justify-content:space-between; gap:14px; text-align:left; border:0; background:transparent; padding:9px 24px; font-size:14.5px; color:#2e2e2b; cursor:pointer;"
