    const crumbs = chain.map((n, i) => ({
      label: n.label,
      go: this.nav(n.id),
      style: "border:0; background:transparent; padding:2px 4px; font-size:13px; color:" + (i === chain.length - 1 ? "#2e2e2b" : "#6f6f68") + "; text-decoration:" + (i === chain.length - 1 ? "none" : "underline") + "; cursor:pointer;"
    }));

    const quickLinks = [
      this.item("myOCADU", "campus-life/myocadu", true),
      this.item("Admissions", "admissions", true),
      this.item("Events & Exhibitions", "campus-life/events-and-exhibitions"),
      this.item("Dates & Deadlines", "admissions/graduate-admissions/apply/the-process/application-process/important-deadlines"),
      this.item("Service Disruptions", "campus-life/scams-targeting-students"),
      this.item("Contact", "admissions/undergraduate-admissions/get-help/contact-us"),
      this.item("Give Now", "student-services/financial-aid")
    ].map((q, i) => Object.assign(q, {
      style: "display:flex; align-items:center; justify-content:space-between; gap:10px; text-align:left; border:" + (i === 0 ? "1px solid #f2f2ee" : "1px solid transparent") + "; background:transparent; padding:8px 10px; font-size:13.5px; font-weight:600; color:#f2f2ee; cursor:pointer;"
    }));

    const cats = this.cats();
    const hovered = cats.find((c) => c.label === this.state.hovered) || null;
    const menuCats = cats.map((c) => {
      const active = hovered && hovered.label === c.label;
      return {
        label: c.label,
        arrow: c.sub.length > 0,
        hover: () => this.setState({ hovered: c.label }),
        go: c.id ? this.nav(c.id) : () => this.setState({ hovered: c.label }),
        style: "display:flex; align-items:center; justify-content:space-between; gap:14px; text-align:left; border:0; border-left:3px solid " + (active ? "#3a3a37" : "transparent") + "; background:" + (active ? "#e2e2dc" : "transparent") + "; padding:9px 24px 9px 21px; font-size:15px; font-weight:" + (active ? "600" : "400") + "; color:#2e2e2b; cursor:pointer;"
