<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style>
  html, body { margin:0; padding:0; background:#ffffff; }
  body { font-family:"Figtree", Helvetica, Arial, sans-serif; color:#000000; -webkit-font-smoothing:antialiased; }
  button { font-family:inherit; }
  a { color:#000000; text-decoration:underline; }
  a:hover { color:#9C11F0; }
</style>
</helmet>
<div style="max-width:1180px; margin:0 auto; padding:0 40px 120px;">

  <header style="padding:72px 0 44px; border-bottom:4px solid #000;">
    <div style="font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.18em; text-transform:uppercase; color:#9C11F0; margin-bottom:18px;">Extracted from ocadu.ca — current site</div>
    <h1 style="margin:0 0 18px; font-size:76px; line-height:0.94; font-weight:800; letter-spacing:-0.03em;">Design system<br />audit</h1>
    <p style="margin:0; max-width:620px; font-size:17px; line-height:1.5; color:#3F3F3F;">Palette, typography and component inventory read off the live site. Values are sampled from the screenshots, so treat hexes and sizes as close approximations to confirm against production CSS.</p>
  </header>

  <section style="padding:64px 0 0;">
    <div style="display:flex; align-items:baseline; gap:16px; margin-bottom:8px;">
      <span style="font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.16em; color:#8A8A8A;">01</span>
      <h2 style="margin:0; font-size:40px; font-weight:700; letter-spacing:-0.02em;">Colour</h2>
    </div>
    <p style="margin:0 0 32px; max-width:620px; font-size:15px; line-height:1.6; color:#3F3F3F;">Black-and-white foundation with a saturated accent spectrum used as full-bleed colour blocks — one colour per card, never blended or gradiented.</p>

    <h3 style="margin:0 0 14px; font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.16em; text-transform:uppercase; color:#8A8A8A;">Foundation</h3>
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(190px, 1fr)); gap:16px; margin-bottom:44px;">
      <sc-for list="{{ neutrals }}" as="c" hint-placeholder-count="4">
        <div style="border:1px solid #E4E4E4;">
          <div style="{{ c.swatch }}"></div>
          <div style="padding:12px 14px; display:flex; flex-direction:column; gap:4px;">
            <span style="font-size:14px; font-weight:600;">{{ c.name }}</span>
            <sc-if value="{{ showHexCodes }}" hint-placeholder-val="{{ true }}">
              <span style="font-family:'IBM Plex Mono', monospace; font-size:12px; color:#6E6E6E;">{{ c.hex }}</span>
            </sc-if>
            <sc-if value="{{ showUsageNotes }}" hint-placeholder-val="{{ true }}">
              <span style="font-size:12.5px; line-height:1.45; color:#6E6E6E;">{{ c.use }}</span>
            </sc-if>
          </div>
        </div>
      </sc-for>
    </div>

    <h3 style="margin:0 0 14px; font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.16em; text-transform:uppercase; color:#8A8A8A;">Accent spectrum</h3>
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(160px, 1fr)); gap:16px;">
      <sc-for list="{{ accents }}" as="c" hint-placeholder-count="8">
        <div style="border:1px solid #E4E4E4;">
          <div style="{{ c.swatch }}"></div>
          <div style="padding:12px 14px; display:flex; flex-direction:column; gap:4px;">
            <span style="font-size:14px; font-weight:600;">{{ c.name }}</span>
            <sc-if value="{{ showHexCodes }}" hint-placeholder-val="{{ true }}">
              <span style="font-family:'IBM Plex Mono', monospace; font-size:12px; color:#6E6E6E;">{{ c.hex }}</span>
            </sc-if>
            <sc-if value="{{ showUsageNotes }}" hint-placeholder-val="{{ true }}">
              <span style="font-size:12.5px; line-height:1.45; color:#6E6E6E;">{{ c.use }}</span>
            </sc-if>
          </div>
        </div>
      </sc-for>
    </div>

    <div style="margin-top:28px; border-left:4px solid #9C11F0; padding:4px 0 4px 18px; max-width:640px; font-size:14.5px; line-height:1.6; color:#3F3F3F;">Accents carry text at large sizes only. Copy on yellow-green and cyan is set in black; violet, blue, green, red and orange carry white text.</div>
  </section>

  <section style="padding:72px 0 0;">
    <div style="display:flex; align-items:baseline; gap:16px; margin-bottom:8px;">
      <span style="font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.16em; color:#8A8A8A;">02</span>
      <h2 style="margin:0; font-size:40px; font-weight:700; letter-spacing:-0.02em;">Typography</h2>
    </div>
    <p style="margin:0 0 30px; max-width:620px; font-size:15px; line-height:1.6; color:#3F3F3F;">One geometric sans across the whole site, set very tight at display sizes. Specimen below uses Figtree as the stand-in; confirm the production family before handoff.</p>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:20px; margin-bottom:40px;">
      <div style="border:1px solid #E4E4E4; padding:22px 24px;">
        <div style="font-size:44px; font-weight:700; letter-spacing:-0.02em; line-height:1;">Aa</div>
        <div style="margin-top:14px; font-size:15px; font-weight:600;">Display / headings</div>
        <div style="font-family:'IBM Plex Mono', monospace; font-size:12.5px; color:#6E6E6E; line-height:1.6; margin-top:6px;">Geometric sans · 500–800<br />letter-spacing −2% to −3%<br />line-height 0.94–1.05</div>
      </div>
      <div style="border:1px solid #E4E4E4; padding:22px 24px;">
        <div style="font-size:44px; font-weight:400; letter-spacing:-0.01em; line-height:1;">Aa</div>
        <div style="margin-top:14px; font-size:15px; font-weight:600;">Body / UI</div>
        <div style="font-family:'IBM Plex Mono', monospace; font-size:12.5px; color:#6E6E6E; line-height:1.6; margin-top:6px;">Same family · 400–600<br />line-height 1.45–1.6<br />max measure ≈ 70ch</div>
      </div>
      <div style="border:1px solid #E4E4E4; padding:22px 24px;">
        <div style="font-size:26px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; line-height:1.2;">Label</div>
        <div style="margin-top:20px; font-size:15px; font-weight:600;">Buttons &amp; nav</div>
        <div style="font-family:'IBM Plex Mono', monospace; font-size:12.5px; color:#6E6E6E; line-height:1.6; margin-top:6px;">Uppercase · 600–700<br />letter-spacing 6–10%<br />11–14px</div>
      </div>
    </div>

    <div style="border-top:2px solid #000;">
      <sc-for list="{{ typeScale }}" as="t" hint-placeholder-count="7">
        <div style="display:grid; grid-template-columns:1fr 260px; gap:24px; align-items:baseline; border-bottom:1px solid #E4E4E4; padding:20px 0;">
          <div style="{{ t.style }}">{{ t.sample }}</div>
          <div style="font-family:'IBM Plex Mono', monospace; font-size:12px; color:#6E6E6E; line-height:1.7;">{{ t.spec }}</div>
        </div>
      </sc-for>
    </div>
  </section>

  <section style="padding:72px 0 0;">
    <div style="display:flex; align-items:baseline; gap:16px; margin-bottom:8px;">
      <span style="font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.16em; color:#8A8A8A;">03</span>
      <h2 style="margin:0; font-size:40px; font-weight:700; letter-spacing:-0.02em;">Components</h2>
    </div>

    <h3 style="margin:34px 0 16px; font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.16em; text-transform:uppercase; color:#8A8A8A;">Navigation bar</h3>
    <div style="border:1px solid #E4E4E4;">
      <div style="background:#9C11F0; display:flex; align-items:center; gap:26px; padding:9px 18px; color:#fff; font-size:11px; font-weight:700; letter-spacing:0.09em; text-transform:uppercase;">
        <span>Become a student</span>
        <span>About the university</span>
        <span>After OCAD U</span>
        <span>Partner with us</span>
        <span>Hire our students</span>
        <span>What's on</span>
        <span style="margin-left:auto; display:flex; align-items:stretch; border:1px solid #fff;">
          <span style="padding:6px 10px;">Log in to my OCADU</span>
          <span style="display:grid; place-items:center; width:26px; background:#fff; color:#9C11F0;">→</span>
        </span>
      </div>
      <div style="background:#000; display:flex; align-items:center; gap:22px; padding:14px 18px; color:#fff;">
        <span style="position:relative; display:block; width:52px; height:44px;">
          <span style="position:absolute; top:0; left:0; width:34px; height:30px; border:2px solid #fff; display:grid; grid-template-columns:1fr 1fr; place-items:center; font-size:9px; font-weight:700; padding:2px 3px; box-sizing:border-box;"><span>O</span><span>C</span><span>A</span><span>D</span></span>
          <span style="position:absolute; top:22px; left:27px; width:20px; height:20px; border:2px solid #fff; background:#000; display:grid; place-items:center; font-size:9px; font-weight:700;">U</span>
        </span>
        <span style="margin-left:auto; display:flex; align-items:center; gap:18px; font-size:11px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase;">
          <span style="position:relative; display:block; width:14px; height:14px; border:2px solid #fff; border-radius:50%;"><span style="position:absolute; top:12px; left:11px; display:block; width:2px; height:7px; background:#fff; transform:rotate(-45deg);"></span></span>
          <span style="display:flex; align-items:center; gap:10px;">
            <span style="display:flex; flex-direction:column; gap:3px;">
              <span style="display:block; width:16px; height:2px; background:#fff;"></span>
              <span style="display:block; width:16px; height:2px; background:#fff;"></span>
              <span style="display:block; width:16px; height:2px; background:#fff;"></span>
            </span>
            <span>Menu</span>
          </span>
        </span>
      </div>
      <div style="background:#E9E9E9; padding:10px 18px; font-family:'IBM Plex Mono', monospace; font-size:11.5px; color:#5A5A5A;">Sticky black bar · purple audience strip above · label-left burger, search as outline glyph · grey sub-bar carries the login CTA on interior pages</div>
    </div>

    <h3 style="margin:40px 0 16px; font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.16em; text-transform:uppercase; color:#8A8A8A;">Buttons</h3>
    <div style="display:flex; flex-wrap:wrap; gap:18px; align-items:center; margin-bottom:14px;">
      <button style="display:flex; align-items:stretch; border:2px solid #000; background:#fff; padding:0; font-size:14px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; cursor:pointer;">
        <span style="padding:14px 20px;">OCAD U Admissions</span>
        <span style="display:grid; place-items:center; width:44px; background:#000; color:#fff; font-size:16px;">→</span>
      </button>
      <button style="border:2px solid #000; background:#000; color:#fff; padding:14px 22px; font-size:14px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; cursor:pointer;">Explore programs</button>
      <button style="border:2px solid #000; background:#fff; padding:14px 22px; font-size:14px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; cursor:pointer;">Learn more about our campus</button>
      <button style="border:2px solid #F06020; background:#F06020; color:#fff; padding:14px 22px; font-size:14px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; cursor:pointer;">Learn more →</button>
      <button style="border:0; background:transparent; padding:0 0 4px; border-bottom:2px solid #000; font-size:14px; font-weight:600; cursor:pointer;">Read more →</button>
    </div>
    <div style="font-family:'IBM Plex Mono', monospace; font-size:11.5px; color:#5A5A5A; line-height:1.6;">Square corners throughout (radius 0) · 2px borders · uppercase labels · arrow chip is a filled square appended to the right edge · accent-filled variant only inside a coloured block</div>

    <h3 style="margin:40px 0 16px; font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.16em; text-transform:uppercase; color:#8A8A8A;">Cards</h3>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr)); gap:20px;">
      <div style="background:#F06020; color:#fff; padding:20px; display:flex; flex-direction:column; gap:12px; min-height:280px;">
        <div style="font-size:18px; font-weight:700; line-height:1.2;">Queerious Futurities: Transcultural Belongings in the Darkness</div>
        <div style="font-size:12.5px; font-weight:600;">June 26, 2026 10 a.m. — August 22, 2026 5 p.m.</div>
        <div style="font-size:12.5px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase;">◦ Online only</div>
        <div style="margin-top:auto; height:96px; background:rgba(0,0,0,0.25); display:grid; place-items:center; font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.14em;">IMAGE</div>
        <div style="font-family:'IBM Plex Mono', monospace; font-size:10.5px; opacity:0.85;">EVENT TILE · accent fill</div>
      </div>
      <div style="border:2px solid #20B0F0; background:#fff; padding:20px; display:flex; flex-direction:column; gap:10px; min-height:280px;">
        <div style="font-size:12px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#20B0F0;">Convocation</div>
        <div style="font-size:18px; font-weight:700; line-height:1.25;">OCAD U talent at the 65th Toronto Outdoor Art Fair</div>
        <div style="font-size:13.5px; line-height:1.5; color:#3F3F3F;">Standfirst runs two to three lines and sits above the dated footer rule.</div>
        <div style="margin-top:auto; padding-top:14px; border-top:1px solid #E4E4E4; font-size:12.5px; font-weight:600; color:#6E6E6E;">June 15, 2026</div>
        <div style="font-family:'IBM Plex Mono', monospace; font-size:10.5px; color:#8A8A8A;">NEWS CARD · outlined, accent eyebrow</div>
      </div>
      <div style="background:#000; color:#fff; display:flex; flex-direction:column; min-height:280px;">
        <div style="flex:1; background:#2A2A2A; display:grid; place-items:center; font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.14em; color:#9A9A9A;">PORTRAIT</div>
        <div style="background:#EEF84E; color:#000; padding:14px 16px; display:flex; flex-direction:column; gap:6px;">
          <span style="font-size:15px; font-weight:700;">Graeme McMillan</span>
          <span style="font-size:12.5px; line-height:1.45;">Two-line alumni descriptor sits under the name inside the colour band.</span>
          <span style="font-size:12px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase;">Read more →</span>
        </div>
        <div style="font-family:'IBM Plex Mono', monospace; font-size:10.5px; color:#9A9A9A; padding:8px 16px 12px;">PERSON CARD · image + colour caption band</div>
      </div>
      <div style="background:#9C11F0; color:#fff; padding:22px; display:flex; flex-direction:column; gap:12px; min-height:280px;">
        <div style="font-size:26px; font-weight:700; line-height:1.05;">Program offerings</div>
        <div style="font-size:13.5px; line-height:1.5;">Short promo block used in the colour-block grid; one accent per tile, always square.</div>
        <div style="margin-top:auto; font-size:13px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase;">Learn more →</div>
        <div style="font-family:'IBM Plex Mono', monospace; font-size:10.5px; opacity:0.8;">PROMO TILE · accent fill, no border</div>
      </div>
    </div>

    <h3 style="margin:40px 0 16px; font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.16em; text-transform:uppercase; color:#8A8A8A;">Section header &amp; carousel</h3>
    <div style="border:1px solid #E4E4E4; padding:26px; display:flex; flex-direction:column; gap:22px;">
      <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:24px; flex-wrap:wrap;">
        <h4 style="margin:0; font-size:44px; font-weight:700; line-height:0.98; letter-spacing:-0.02em;">Featured<br />initiatives</h4>
        <button style="display:flex; align-items:stretch; border:2px solid #000; background:#fff; padding:0; font-size:13px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; cursor:pointer;">
          <span style="padding:12px 16px;">See more</span>
          <span style="display:grid; place-items:center; width:38px; background:#000; color:#fff;">→</span>
        </button>
      </div>
      <div style="display:flex; align-items:center; gap:14px; font-family:'IBM Plex Mono', monospace; font-size:13px; color:#3F3F3F;">
        <span style="font-weight:500;">01</span>
        <span style="display:block; width:56px; height:2px; background:#000;"></span>
        <span>04</span>
        <span style="margin-left:14px; display:flex; gap:10px;">
          <span style="width:30px; height:30px; border:2px solid #000; display:grid; place-items:center;">←</span>
          <span style="width:30px; height:30px; border:2px solid #000; display:grid; place-items:center;">→</span>
        </span>
      </div>
    </div>

    <h3 style="margin:40px 0 16px; font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.16em; text-transform:uppercase; color:#8A8A8A;">Footer</h3>
    <div style="background:#000; color:#fff; padding:34px 26px; display:grid; grid-template-columns:1.2fr 1fr 1fr; gap:30px;">
      <div style="display:flex; flex-direction:column; gap:18px;">
        <span style="position:relative; display:block; width:52px; height:44px;">
          <span style="position:absolute; top:0; left:0; width:34px; height:30px; border:2px solid #fff; display:grid; grid-template-columns:1fr 1fr; place-items:center; font-size:9px; font-weight:700; padding:2px 3px; box-sizing:border-box;"><span>O</span><span>C</span><span>A</span><span>D</span></span>
          <span style="position:absolute; top:22px; left:27px; width:20px; height:20px; border:2px solid #fff; background:#000; display:grid; place-items:center; font-size:9px; font-weight:700;">U</span>
        </span>
        <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; border-bottom:1px solid #fff; padding-bottom:8px; font-size:13px; color:#C9C9C9;"><span>Search for…</span><span>⌕</span></div>
      </div>
      <div style="display:flex; flex-direction:column; gap:6px; font-size:12.5px; color:#C9C9C9;">
        <span style="font-size:13px; font-weight:700; color:#fff;">Campus details</span>
        <span>100 McCaul Street, Toronto</span>
        <span>416-977-6000</span>
      </div>
      <div style="display:flex; flex-direction:column; gap:6px; font-size:12.5px; color:#C9C9C9;">
        <span style="font-size:13px; font-weight:700; color:#fff;">Helpful links</span>
        <span>my.OCADU.ca</span>
        <span>Admissions</span>
        <span>Campus Map</span>
      </div>
    </div>
  </section>

  <section style="padding:72px 0 0;">
    <div style="display:flex; align-items:baseline; gap:16px; margin-bottom:8px;">
      <span style="font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.16em; color:#8A8A8A;">04</span>
      <h2 style="margin:0; font-size:40px; font-weight:700; letter-spacing:-0.02em;">Patterns to note</h2>
    </div>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:18px; margin-top:24px;">
      <sc-for list="{{ patterns }}" as="p" hint-placeholder-count="5">
        <div style="border-top:3px solid #000; padding:16px 0 0; display:flex; flex-direction:column; gap:8px;">
          <span style="font-size:17px; font-weight:700;">{{ p.name }}</span>
          <span style="font-size:14px; line-height:1.55; color:#3F3F3F;">{{ p.note }}</span>
        </div>
      </sc-for>
    </div>
  </section>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;showHexCodes&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Audit display&quot;},&quot;showUsageNotes&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Audit display&quot;}}">
const sw = (hex, dark) => "height:96px; background:" + hex + "; border-bottom:1px solid " + (dark ? "#000" : "#E4E4E4") + ";";

class Component extends DCLogic {
  renderVals() {
    return {
      showHexCodes: this.props.showHexCodes !== false,
      showUsageNotes: this.props.showUsageNotes !== false,
      neutrals: [
        { name: "Black", hex: "#000000", use: "Nav bar, footer, display type, all borders", swatch: sw("#000000") },
        { name: "White", hex: "#FFFFFF", use: "Default page ground", swatch: sw("#FFFFFF", true) },
        { name: "Off-white", hex: "#F2F2F2", use: "Hero/video ground, alternating bands", swatch: sw("#F2F2F2") },
        { name: "Grey bar", hex: "#D9D9D9", use: "Utility sub-bar behind the login CTA", swatch: sw("#D9D9D9") },
        { name: "Body grey", hex: "#3F3F3F", use: "Long-form body copy", swatch: sw("#3F3F3F") },
        { name: "Meta grey", hex: "#8A8A8A", use: "Dates, captions, counters", swatch: sw("#8A8A8A") }
      ],
      accents: [
        { name: "Violet", hex: "#9C11F0", use: "Most-used accent: audience strip, promo tiles, brush motifs", swatch: sw("#9C11F0") },
        { name: "Cyan", hex: "#20B0F0", use: "News cards, callouts, audience CTA", swatch: sw("#20B0F0") },
        { name: "Blue", hex: "#0070FF", use: "Secondary tiles and image-overlay blocks", swatch: sw("#0070FF") },
        { name: "Yellow-green", hex: "#EEF84E", use: "Alumni caption bands, event tiles", swatch: sw("#EEF84E") },
        { name: "Green", hex: "#40B050", use: "Event tiles", swatch: sw("#40B050") },
        { name: "Orange", hex: "#F06020", use: "Event tiles, primary CTA on dark", swatch: sw("#F06020") },
        { name: "Red", hex: "#FF1020", use: "Event tiles", swatch: sw("#FF1020") }
      ],
      typeScale: [
        { sample: "This is not the end", spec: "Mega display · 92–120px · 800 · −3% · 0.94", style: "font-size:76px; font-weight:800; letter-spacing:-0.03em; line-height:0.94;" },
        { sample: "Get started", spec: "H1 · 52–60px · 700 · −2% · 1.0", style: "font-size:54px; font-weight:700; letter-spacing:-0.02em; line-height:1;" },
        { sample: "Featured initiatives", spec: "H2 · 40–44px · 700 · −2% · 1.0", style: "font-size:42px; font-weight:700; letter-spacing:-0.02em; line-height:1;" },
        { sample: "Undergraduate admissions", spec: "H3 · 28–32px · 700 · 1.1", style: "font-size:30px; font-weight:700; letter-spacing:-0.01em; line-height:1.1;" },
        { sample: "OCAD U receives grants to advance research on the arts", spec: "Card title · 17–20px · 700 · 1.2", style: "font-size:19px; font-weight:700; line-height:1.2;" },
        { sample: "You belong here! At OCAD University, one degree can lead to endless career paths.", spec: "Body · 16px · 400 · 1.5", style: "font-size:16px; font-weight:400; line-height:1.5; color:#3F3F3F;" },
        { sample: "July 9, 2026 · Online only", spec: "Meta · 12–13px · 600 · 1.45", style: "font-size:12.5px; font-weight:600; color:#6E6E6E;" },
        { sample: "Explore programs", spec: "Button/nav label · 11–14px · 700 · +6–10% · uppercase", style: "font-size:13px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase;" }
      ],
      patterns: [
        { name: "Torn-paper dividers", note: "Ragged raster edge separates major bands. Decorative only — never carries content or interaction." },
        { name: "Colour-block mosaic", note: "Events and promos tile as flush squares of solid accent with no gutters, image and colour alternating." },
        { name: "Square geometry", note: "Zero border radius everywhere: cards, buttons, inputs, image crops, the logo lockup." },
        { name: "Arrow chip CTA", note: "Every primary action pairs an uppercase label with a filled square arrow at its right edge." },
        { name: "Overlapping lockup", note: "Logo is two outlined squares — OCAD in a 2×2 grid, U overlapping the lower-right corner." },
