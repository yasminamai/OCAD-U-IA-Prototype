<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
<script src="./image-slot.js"></script>
<style>
  html, body { margin:0; padding:0; background:#ffffff; }
  body { font-family:"Figtree", Helvetica, Arial, sans-serif; color:#000000; -webkit-font-smoothing:antialiased; }
  button { font-family:inherit; }
  a { color:#000000; text-decoration:underline; }
  a:hover { color:#9C11F0; }
  @keyframes dcFade { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:none; } }
</style>
</helmet>
<div style="position:relative; background:#ffffff;">
<div style="position:fixed; top:14px; right:14px; z-index:60; display:flex; align-items:center; gap:0; border:2px solid #000000; background:#ffffff; box-shadow:0 2px 0 #000000;">
  <button onClick="{{ setIaView }}" style="{{ iaBtnStyle }}">IA view</button>
  <button onClick="{{ setNormalView }}" style="{{ normalBtnStyle }}">Normal view</button>
</div>
<div style="{{ shellStyle }}">

  <sc-if value="{{ showTaskStrip }}" hint-placeholder-val="{{ true }}">
    <div style="display:flex; align-items:center; gap:16px; padding:9px 240px 9px 28px; background:#9C11F0; color:#ffffff; font-family:'IBM Plex Mono', monospace; font-size:11.5px; letter-spacing:0.08em;">
      <span style="border:1px solid #ffffff; padding:2px 7px; text-transform:uppercase;">Task</span>
      <span>“I want to send something back.”</span>
      <span style="margin-left:auto; opacity:0.85;">clicks: {{ clicks }}</span>
      <button onClick="{{ reset }}" style="background:transparent; color:#ffffff; border:1px solid #ffffff; padding:3px 9px; font-family:'IBM Plex Mono', monospace; font-size:11.5px; cursor:pointer;">reset</button>
    </div>
  </sc-if>

  <header style="background:#000000; color:#ffffff; padding:0 28px; position:relative; z-index:5;">
    <div style="display:flex; align-items:center; gap:24px; padding:16px 0;">
      <button onClick="{{ goHome }}" style="border:0; background:transparent; padding:0; cursor:pointer;">
        <span style="position:relative; display:block; width:78px; height:64px;">
          <span style="position:absolute; top:0; left:0; width:52px; height:44px; border:2px solid #ffffff; display:grid; grid-template-columns:1fr 1fr; place-items:center; font-size:13px; font-weight:700; color:#ffffff; padding:3px 5px; box-sizing:border-box;"><span>O</span><span>C</span><span>A</span><span>D</span></span>
          <span style="position:absolute; top:32px; left:41px; width:30px; height:30px; border:2px solid #ffffff; background:#000000; display:grid; place-items:center; font-size:13px; font-weight:700; color:#ffffff;">U</span>
        </span>
      </button>
      <div style="margin-left:auto; display:flex; align-items:center; gap:10px;">
        <button style="display:flex; align-items:center; gap:11px; border:2px solid #ffffff; background:transparent; padding:9px 14px; font-size:12.5px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#ffffff; cursor:pointer;" style-hover="background:#ffffff; color:#000000;">
          <span>Search</span>
          <span style="position:relative; display:block; width:14px; height:14px; border:2px solid currentColor; border-radius:50%;">
            <span style="position:absolute; top:12px; left:11px; display:block; width:2px; height:7px; background:currentColor; transform:rotate(-45deg);"></span>
          </span>
        </button>
        <button onClick="{{ toggleMenu }}" style="{{ menuBtnStyle }}">
          <span>Menu</span>
          <sc-if value="{{ menuOpen }}" hint-placeholder-val="{{ false }}">
            <span style="font-size:15px; line-height:1;">✕</span>
          </sc-if>
          <sc-if value="{{ menuClosed }}" hint-placeholder-val="{{ true }}">
            <span style="display:flex; flex-direction:column; gap:3px;">
              <span style="display:block; width:17px; height:2px; background:currentColor;"></span>
              <span style="display:block; width:17px; height:2px; background:currentColor;"></span>
              <span style="display:block; width:17px; height:2px; background:currentColor;"></span>
            </span>
          </sc-if>
        </button>
      </div>
    </div>
  </header>

  <div style="background:#D9D9D9; display:flex; justify-content:flex-end; padding:10px 28px;">
    <button onClick="{{ goMyOcadu }}" style="display:flex; align-items:stretch; border:2px solid #000000; background:#ffffff; padding:0; font-size:11.5px; font-weight:700; letter-spacing:0.09em; text-transform:uppercase; color:#000000; cursor:pointer;" style-hover="background:#EEF84E;">
      <span style="padding:8px 14px;">Log in to my OCADU</span>
      <span style="display:grid; place-items:center; width:32px; background:#000000; color:#ffffff; font-size:13px;">→</span>
    </button>
  </div>

  <sc-if value="{{ menuOpen }}" hint-placeholder-val="{{ false }}">
    <div onMouseLeave="{{ clearHover }}" style="{{ menuGrid }}">
      <div style="background:#000000; padding:26px 20px 44px; display:flex; flex-direction:column; gap:2px; animation:dcFade 140ms ease-out;">
        <sc-for list="{{ quickLinks }}" as="q" hint-placeholder-count="7">
          <button onClick="{{ q.go }}" style="{{ q.style }}" style-hover="background:#9C11F0;">
            <span>{{ q.label }}</span>
            <sc-if value="{{ q.external }}" hint-placeholder-val="{{ false }}">
              <span style="font-size:11px;">↗</span>
            </sc-if>
          </button>
        </sc-for>
      </div>

      <div style="background:#ffffff; padding:26px 0 44px; display:flex; flex-direction:column; animation:dcFade 200ms ease-out 60ms both;">
        <sc-for list="{{ menuCats }}" as="cat" hint-placeholder-count="13">
          <button onClick="{{ cat.go }}" onMouseEnter="{{ cat.hover }}" onFocus="{{ cat.hover }}" style="{{ cat.style }}">
            <span>{{ cat.label }}</span>
            <sc-if value="{{ cat.arrow }}" hint-placeholder-val="{{ true }}">
              <span>›</span>
            </sc-if>
          </button>
        </sc-for>
      </div>

      <sc-if value="{{ hasSub }}" hint-placeholder-val="{{ false }}">
        <div style="background:#0070FF; color:#ffffff; padding:26px 0 44px; display:flex; flex-direction:column; animation:dcFade 160ms ease-out;">
          <div style="padding:0 24px 14px; font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; opacity:0.85;">{{ hoveredLabel }}</div>
          <sc-for list="{{ subItems }}" as="s" hint-placeholder-count="6">
            <button onClick="{{ s.go }}" style="{{ s.style }}" style-hover="background:#0060DD;">
              <span>{{ s.label }}</span>
              <sc-if value="{{ s.arrow }}" hint-placeholder-val="{{ false }}">
                <span>›</span>
              </sc-if>
            </button>
          </sc-for>
        </div>
      </sc-if>
    </div>
  </sc-if>

  <sc-if value="{{ isHome }}" hint-placeholder-val="{{ true }}">
    <main style="flex:1;">
      <section style="background:#F2F2F2; height:600px; position:relative; overflow:hidden;">
        <sc-if value="{{ normalView }}" hint-placeholder-val="{{ true }}">
          <image-slot id="home-hero-video" shape="rect" placeholder="Drop the homepage video poster frame" style="position:absolute; inset:0; width:100%; height:100%;"></image-slot>
        </sc-if>
        <sc-if value="{{ iaView }}" hint-placeholder-val="{{ false }}">
          <div style="position:absolute; inset:0; background:#E4E4E4; display:grid; place-items:center; font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.2em; color:#8A8A8A;">VIDEO</div>
        </sc-if>
        <div style="position:absolute; top:24px; left:28px; padding:6px 10px; background:#000000; font-family:'IBM Plex Mono', monospace; font-size:11.5px; letter-spacing:0.18em; text-transform:uppercase; color:#ffffff; pointer-events:none;">Video — {{ videoState }}</div>
        <button onClick="{{ toggleVideo }}" style="{{ videoBtnStyle }}">
          <span style="{{ playGlyphStyle }}">▶</span>
          <span style="{{ pauseGlyphStyle }}">
            <span style="display:block; width:6px; height:26px; background:currentColor;"></span>
            <span style="display:block; width:6px; height:26px; background:currentColor;"></span>
          </span>
        </button>
      </section>

      <section style="max-width:1240px; margin:0 auto; padding:64px 40px 34px;">
        <div style="display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto; gap:48px; align-items:center;">
          <h1 style="margin:0; font-size:60px; line-height:0.98; font-weight:700; letter-spacing:-0.025em;">Get started</h1>
          <p style="margin:0; font-size:16px; line-height:1.5; color:#3F3F3F; max-width:380px;">You belong here. At OCAD University, one degree can lead to endless career paths.</p>
          <button onClick="{{ goAdmissions }}" style="display:flex; align-items:stretch; border:2px solid #000000; background:#ffffff; padding:0; font-size:14px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; color:#000000; cursor:pointer;" style-hover="background:#EEF84E;">
            <span style="padding:16px 22px;">OCAD U Admissions</span>
            <span style="display:grid; place-items:center; width:48px; background:#000000; color:#ffffff; font-size:17px;">→</span>
          </button>
        </div>
      </section>

      <section style="max-width:1240px; margin:0 auto; padding:20px 40px 80px;">
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(330px, 1fr)); gap:32px;">
          <sc-for list="{{ promos }}" as="p" hint-placeholder-count="2">
            <button onClick="{{ p.go }}" style="display:flex; flex-direction:column; text-align:left; border:0; background:transparent; padding:0; cursor:pointer;">
              <span style="display:block; position:relative; width:100%; height:300px;">
                <sc-if value="{{ normalView }}" hint-placeholder-val="{{ true }}">
                  <image-slot id="{{ p.slotId }}" shape="rect" placeholder="{{ p.slotHint }}" style="position:absolute; inset:0; width:100%; height:100%;"></image-slot>
                </sc-if>
                <sc-if value="{{ iaView }}" hint-placeholder-val="{{ false }}">
                  <span style="position:absolute; inset:0; background:#E4E4E4; display:grid; place-items:center; font-family:'IBM Plex Mono', monospace; font-size:11.5px; letter-spacing:0.2em; color:#8A8A8A;">IMAGE</span>
                </sc-if>
              </span>
              <span style="{{ p.band }}">
                <span style="font-size:22px; font-weight:700; line-height:1.15;">{{ p.title }}</span>
                <span style="font-size:14.5px; line-height:1.5;">{{ p.sub }}</span>
                <span style="font-size:12.5px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase;">Read more →</span>
              </span>
            </button>
          </sc-for>
        </div>
      </section>
    </main>
  </sc-if>

  <sc-if value="{{ isInterior }}" hint-placeholder-val="{{ false }}">
    <div style="flex:1; display:grid; grid-template-columns:300px 1fr; align-items:start;">
      <aside style="border-right:2px solid #000000; min-height:100%; padding:28px 0 70px;">
        <div style="padding:0 22px 14px; font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#8A8A8A;">{{ sectionLabel }}</div>
        <div style="display:flex; flex-direction:column;">
          <sc-for list="{{ sideNav }}" as="item" hint-placeholder-count="8">
            <button onClick="{{ item.go }}" style="{{ item.style }}" style-hover="background:#F2F2F2;">{{ item.label }}</button>
          </sc-for>
        </div>
      </aside>

      <main style="padding:30px 48px 90px; max-width:1000px;">
        <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:24px;">
          <sc-for list="{{ crumbs }}" as="c" hint-placeholder-count="3">
            <button onClick="{{ c.go }}" style="{{ c.style }}">{{ c.label }}</button>
          </sc-for>
        </nav>

        <h1 style="margin:0 0 10px; font-size:52px; line-height:1; font-weight:700; letter-spacing:-0.025em;">{{ title }}</h1>

        <sc-if value="{{ showAnnotations }}" hint-placeholder-val="{{ true }}">
          <div style="font-family:'IBM Plex Mono', monospace; font-size:11px; color:#8A8A8A; margin-bottom:28px;">{{ pathText }}</div>
        </sc-if>

        <p style="margin:0 0 40px; max-width:640px; font-size:16px; line-height:1.55; color:#3F3F3F;">Body copy placeholder for this page. Real content sits here at roughly 60–70 characters per line, black on white, with links underlined in violet on hover.</p>

        <sc-if value="{{ isRefunds }}" hint-placeholder-val="{{ false }}">
          <section style="display:flex; flex-direction:column; gap:30px; margin-bottom:48px;">
            <div>
              <h2 style="margin:0 0 16px; font-size:26px; font-weight:700; letter-spacing:-0.01em;">Send something back</h2>
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px,1fr)); gap:0;">
                <sc-for list="{{ refundTiles }}" as="t" hint-placeholder-count="4">
                  <div style="{{ t.style }}">{{ t.label }}</div>
                </sc-for>
              </div>
            </div>

            <div>
              <h2 style="margin:0 0 12px; font-size:20px; font-weight:700;">Before you start</h2>
              <ul style="margin:0; padding-left:20px; font-size:15px; line-height:1.75; color:#3F3F3F;">
                <li>Your student number and banking details</li>
                <li>The term and fee the return applies to</li>
                <li>Proof of payment (receipt or statement)</li>
              </ul>
            </div>

            <sc-if value="{{ submitted }}" hint-placeholder-val="{{ false }}">
              <div style="background:#EEF84E; color:#000000; padding:26px 28px;">
                <div style="font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; margin-bottom:10px;">Confirmation</div>
                <h2 style="margin:0 0 10px; font-size:24px; font-weight:700;">Return request submitted</h2>
                <p style="margin:0 0 20px; font-size:15px; line-height:1.5;">Reference RF-2026-0148. Student Accounts will respond within 5 business days.</p>
                <button onClick="{{ goStudentAccounts }}" style="display:flex; align-items:stretch; border:2px solid #000000; background:#ffffff; padding:0; font-size:13px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; cursor:pointer;">
                  <span style="padding:12px 18px;">Back to Student Accounts</span>
                  <span style="display:grid; place-items:center; width:40px; background:#000000; color:#ffffff;">→</span>
                </button>
              </div>
            </sc-if>

            <div style="display:flex; gap:16px; flex-wrap:wrap; align-items:center;">
              <button onClick="{{ submit }}" style="display:flex; align-items:stretch; border:2px solid #F06020; background:#F06020; color:#ffffff; padding:0; font-size:14px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; cursor:pointer;" style-hover="background:#D65317;">
                <span style="padding:16px 22px;">Start a return request</span>
                <span style="display:grid; place-items:center; width:48px; background:#000000; font-size:17px;">→</span>
              </button>
              <button style="border:2px solid #000000; background:#ffffff; padding:16px 22px; font-size:14px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; cursor:pointer;" style-hover="background:#F2F2F2;">Check status of a request</button>
            </div>
          </section>
        </sc-if>

        <sc-if value="{{ hasKids }}" hint-placeholder-val="{{ true }}">
          <section>
            <h2 style="margin:0 0 18px; font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#8A8A8A;">In this section</h2>
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:16px;">
              <sc-for list="{{ kids }}" as="kid" hint-placeholder-count="6">
                <button onClick="{{ kid.go }}" style="display:flex; align-items:center; justify-content:space-between; gap:14px; text-align:left; border:2px solid #000000; background:#ffffff; padding:18px 20px; font-size:16px; font-weight:600; color:#000000; cursor:pointer;" style-hover="background:#EEF84E;">
                  <span>{{ kid.label }}</span>
                  <span style="font-size:17px;">→</span>
                </button>
              </sc-for>
            </div>
          </section>
        </sc-if>

        <sc-if value="{{ isPlainLeaf }}" hint-placeholder-val="{{ false }}">
          <section style="display:grid; grid-template-columns:1fr 320px; gap:34px; align-items:start;">
            <div style="display:flex; flex-direction:column; gap:10px;">
              <div style="height:12px; background:#E4E4E4; width:100%;"></div>
              <div style="height:12px; background:#E4E4E4; width:96%;"></div>
              <div style="height:12px; background:#E4E4E4; width:88%;"></div>
              <div style="height:12px; background:#E4E4E4; width:100%;"></div>
              <div style="height:12px; background:#E4E4E4; width:70%;"></div>
            </div>
            <div style="height:220px; background:#E4E4E4; display:grid; place-items:center; font-family:'IBM Plex Mono', monospace; font-size:11.5px; letter-spacing:0.18em; color:#8A8A8A;">IMAGE</div>
          </section>
        </sc-if>
      </main>
    </div>
  </sc-if>

  <div style="background:#000000; height:120px; border-bottom:6px solid #000000;"></div>

  <footer style="background:#ffffff; color:#000000; padding:40px 40px 56px;">
    <div style="max-width:1240px; margin:0 auto; display:flex; flex-direction:column; gap:34px;">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; background:#000000; color:#ffffff; padding:14px 20px; margin:0 auto; width:min(760px, 100%);">
        <span style="font-size:14px; font-weight:700;">Search for…</span>
        <span style="position:relative; display:block; width:15px; height:15px; border:2px solid #ffffff; border-radius:50%;">
          <span style="position:absolute; top:13px; left:12px; display:block; width:2px; height:8px; background:#ffffff; transform:rotate(-45deg);"></span>
        </span>
      </div>

      <div style="display:grid; grid-template-columns:auto minmax(0,1.4fr) minmax(0,1fr) minmax(0,0.8fr); gap:44px; align-items:start;">
        <div style="display:flex; flex-direction:column; gap:40px;">
          <span style="position:relative; display:block; width:78px; height:64px;">
            <span style="position:absolute; top:0; left:0; width:52px; height:44px; border:2px solid #000000; display:grid; grid-template-columns:1fr 1fr; place-items:center; font-size:13px; font-weight:700; padding:3px 5px; box-sizing:border-box;"><span>O</span><span>C</span><span>A</span><span>D</span></span>
            <span style="position:absolute; top:32px; left:41px; width:30px; height:30px; border:2px solid #000000; background:#ffffff; display:grid; place-items:center; font-size:13px; font-weight:700;">U</span>
          </span>
          <div style="display:flex; gap:14px; font-size:15px; color:#000000;">
            <span>f</span>
            <span>♪</span>
            <span>◎</span>
            <span>✕</span>
            <span>▶</span>
            <span>in</span>
            <span>V</span>
          </div>
        </div>

        <p style="margin:0; font-size:12.5px; line-height:1.6; color:#3F3F3F; max-width:340px;">OCAD University acknowledges the ancestral territories of the Mississaugas of the Credit, the Haudenosaunee, the Anishinaabeg and the Huron-Wendat, who are the original owners and custodians of the land on which we live, work and create.</p>

        <div style="display:flex; flex-direction:column; gap:12px; font-size:12.5px; line-height:1.55; color:#3F3F3F;">
          <span style="font-size:15px; font-weight:700; color:#000000;">Campus details</span>
          <span>416.977.6000</span>
          <span><span style="font-weight:700; color:#000000;">For immediate security assistance or emergencies</span><br />416-977-6000 ext. 511</span>
          <span><span style="font-weight:700; color:#000000;">For non-emergency security inquiries</span><br />416-977-6000 ext. 366</span>
          <span>100 McCaul Street, Toronto,<br />Ontario, Canada M5T 1W1</span>
          <span style="color:#8A8A8A;">© 2026 OCAD University</span>
        </div>

        <div style="display:flex; flex-direction:column; gap:9px;">
          <span style="font-size:15px; font-weight:700; margin-bottom:3px;">Helpful links</span>
          <sc-for list="{{ helpful }}" as="h" hint-placeholder-count="7">
            <button onClick="{{ h.go }}" style="display:flex; align-items:center; gap:6px; text-align:left; border:0; background:transparent; padding:0; font-size:12.5px; color:#3F3F3F; cursor:pointer;" style-hover="color:#9C11F0;">
              <sc-if value="{{ h.external }}" hint-placeholder-val="{{ false }}">
                <span style="font-size:11px;">↗</span>
              </sc-if>
              <span>{{ h.label }}</span>
            </button>
          </sc-for>
        </div>
      </div>
    </div>
  </footer>
</div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;showTaskStrip&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Test setup&quot;},&quot;showAnnotations&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Test setup&quot;},&quot;startScreen&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;Home&quot;,&quot;Admissions&quot;,&quot;Campus Life&quot;,&quot;Student Services&quot;],&quot;default&quot;:&quot;Home&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Test setup&quot;}}">
const TREE = [
  ["Home", [
    ["About OCADU", ["History","Vision and Mission","Facts and Figures","Our Campus","Media","Hours of Operation","Security","President","Leadership"]],
    ["Academics", ["Faculty of Art","Faculty of Design","Faculty of Arts and Science","School of Graduate Studies","School of Continuing Studies","Explore Faculty","Mobility & Exchange"]]
  ]],
  ["Admissions", [
    "Become a Student",
    ["Undergraduate Admissions", [
      ["Discover", ["About OCAD U","For New Students","For International Applicants","For Indigenous Applicants","For Parents and Families","For Teachers and Counsellors"]],
      ["Study", ["Undergraduate Programs"]],
      ["Apply", ["Guide to Admissions","Preparing a Portfolio","Academic Requirements","English Language Proficiency","Special Student Status","Transfer Options"]],
      ["Finances", ["Tuition","Funding","Housing info"]],
      ["Visit", ["Events","Explore Campus","Workshops & Summer Programs","Open House"]],
      ["Get Help", ["FAQs","Contact Us"]]
    ]],
    ["Graduate Admissions", [
      ["Discover", ["Your Experience","Our Facilities","Our People","Research","For international Applicants"]],
      ["Study", ["Graduate Programs"]],
      ["Apply", [
        ["The Process", [
          ["Application Process", ["Important Deadlines","Guide to Undergraduate Applications","Graduate Application timeline"]],
          "Application Requirements",
          "Application Tips"
        ]]
      ]],
      ["Finances", ["Tuition","Funding","Housing info"]],
      ["Visit", ["Events","Explore Campus","Open House"]],
      "Get Help"
    ]],
    "Continuing Studies"
  ]],
  ["Campus Life", [
    ["Overview", [["Explore Campus", ["Book a Campus Tour"]]]],
    ["Our Campus", ["Book a Campus Tour"]],
    "Events and Exhibitions",
    "Parents and Families",
    "Diversity",
    "Student Clubs",
    "Mentorship",
    "Student Leadership",
    "Scams Targeting Students",
    "MyOCADU"
  ]],
  ["Student Services", [
    ["Student Wellness Centre", ["Peer Wellness Programs","Get Help Now","Health and Dental","Our Team"]],
    ["Student Accessibility Services", ["Registering with SAS","Privacy and Confidentiality","Support Programs and Events"]],
    ["Financial Aid", ["Bursaries","Financial Planning",["Scholarships & Awards", ["Study Awards"]]]],
    ["Student Accounts", ["Tuition & Fees","How to Pay Tuition","Payment Plans","Refunds","Laptop Program Fees","Other Fees"]]
  ]]
];

const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

const NODES = {};
const ROOTS = [];
(function build(list, parent) {
  list.forEach((raw) => {
    const label = Array.isArray(raw) ? raw[0] : raw;
    const kids = Array.isArray(raw) ? raw[1] : [];
    const id = (parent ? parent.id + "/" : "") + slug(label);
    const node = { id, label, parent: parent ? parent.id : null, children: [], depth: parent ? parent.depth + 1 : 0, section: parent ? parent.section : id };
    NODES[id] = node;
    if (parent) parent.children.push(id); else ROOTS.push(id);
    build(kids, node);
  });
})(TREE, null);

const ACCENTS = ["#F06020", "#20B0F0", "#EEF84E", "#40B050"];

class Component extends DCLogic {
  state = { id: null, clicks: 0, submitted: false, menuOpen: false, hovered: null, playing: false };

  current() {
    const start = this.props.startScreen || "Home";
    return NODES[this.state.id] || NODES[slug(start)] || NODES[ROOTS[0]];
  }

  nav(id) {
    return () => this.setState((s) => ({ id, clicks: s.clicks + 1, submitted: false, menuOpen: false, hovered: null }));
  }

  item(label, id, external) {
    const node = id ? NODES[id] : null;
    return {
      label: label || (node ? node.label : ""),
      external: !!external,
      arrow: !!(node && node.children.length),
      go: node ? this.nav(id) : () => {}
    };
  }

  cats() {
    const k = (id) => NODES[id].children;
    return [
      { label: "About OCAD U", id: "home/about-ocadu", sub: k("home/about-ocadu").map((i) => this.item(null, i)) },
      { label: "Programs", id: null, sub: [
        this.item("Undergraduate Programs", "admissions/undergraduate-admissions/study/undergraduate-programs"),
        this.item("Graduate Programs", "admissions/graduate-admissions/study/graduate-programs"),
        this.item("Continuing Studies", "admissions/continuing-studies")
      ] },
      { label: "Academics", id: "home/academics", sub: k("home/academics").map((i) => this.item(null, i)) },
      { label: "Admissions", id: "admissions", sub: [
        this.item("Become a Student", "admissions/become-a-student"),
        this.item("Undergraduate Admissions", "admissions/undergraduate-admissions", true),
        this.item("Graduate Admissions", "admissions/graduate-admissions", true),
        this.item("Continuing Studies", "admissions/continuing-studies")
      ] },
      { label: "Campus Life", id: "campus-life", sub: k("campus-life").map((i) => this.item(null, i)) },
      { label: "Student Services", id: "student-services", sub: k("student-services").map((i) => this.item(null, i)) },
      { label: "Wellness", id: "student-services/student-wellness-centre", sub: k("student-services/student-wellness-centre").map((i) => this.item(null, i)) },
      { label: "Galleries", id: null, sub: [] },
      { label: "Research and Innovation", id: null, sub: [] },
      { label: "Giving", id: null, sub: [] },
      { label: "Alumni", id: null, sub: [] },
      { label: "School of Continuing Studies", id: "admissions/continuing-studies", sub: [] },
      { label: "Employment", id: null, sub: [] }
    ];
  }

  ancestry(node) {
    const chain = [];
    let n = node;
    while (n) { chain.unshift(n); n = n.parent ? NODES[n.parent] : null; }
    return chain;
  }

  renderVals() {
    const cur = this.current();
    const chain = this.ancestry(cur);
    const onPath = new Set(chain.map((n) => n.id));
    const isHome = cur.id === "home";

    const sideNav = [];
    const walk = (id) => {
      const n = NODES[id];
      const active = n.id === cur.id;
      sideNav.push({
        label: n.label,
        go: this.nav(id),
        style: "text-align:left; border:0; border-left:4px solid " + (active ? "#9C11F0" : "transparent") + "; background:" + (active ? "#F2F2F2" : "transparent") + "; padding:10px 20px 10px " + (16 + (n.depth - 1) * 16) + "px; font-size:" + (n.depth === 1 ? "15px" : "14px") + "; font-weight:" + (active ? "700" : "400") + "; color:" + (n.depth > 2 ? "#3F3F3F" : "#000000") + "; cursor:pointer;"
      });
      if (onPath.has(id)) n.children.forEach(walk);
    };
    NODES[cur.section].children.forEach(walk);

    const crumbs = chain.map((n, i) => {
      const last = i === chain.length - 1;
      return {
        label: n.label,
        go: this.nav(n.id),
        style: "border:0; background:transparent; padding:0 4px 0 0; font-family:'IBM Plex Mono', monospace; font-size:11.5px; letter-spacing:0.06em; text-transform:uppercase; color:" + (last ? "#000000" : "#8A8A8A") + "; text-decoration:" + (last ? "none" : "underline") + "; cursor:pointer;"
      };
    });

    const quickLinks = [
      this.item("myOCADU", "campus-life/myocadu", true),
      this.item("Admissions", "admissions", true),
      this.item("Events & Exhibitions", "campus-life/events-and-exhibitions"),
      this.item("Dates & Deadlines", "admissions/graduate-admissions/apply/the-process/application-process/important-deadlines"),
      this.item("Service Disruptions", "campus-life/scams-targeting-students"),
      this.item("Contact", "admissions/undergraduate-admissions/get-help/contact-us"),
      this.item("Give Now", "student-services/financial-aid")
    ].map((q, i) => Object.assign(q, {
      style: "display:flex; align-items:center; justify-content:space-between; gap:10px; text-align:left; border:2px solid " + (i === 0 ? "#ffffff" : "transparent") + "; background:transparent; padding:8px 10px; font-size:13px; font-weight:700; letter-spacing:0.04em; color:#ffffff; cursor:pointer;"
    }));

    const cats = this.cats();
    const hovered = cats.find((c) => c.label === this.state.hovered) || null;
    const menuCats = cats.map((c) => {
      const active = hovered && hovered.label === c.label;
      return {
        label: c.label,
        arrow: c.sub.length > 0,
        hover: () => this.setState({ hovered: c.label }),
        go: c.id ? this.nav(c.id) : () => this.setState({ hovered: c.label }),
        style: "display:flex; align-items:center; justify-content:space-between; gap:14px; text-align:left; border:0; background:" + (active ? "#0070FF" : "transparent") + "; padding:10px 24px; font-size:16px; font-weight:" + (active ? "700" : "500") + "; color:" + (active ? "#ffffff" : "#000000") + "; cursor:pointer;"
      };
    });
    const subItems = (hovered ? hovered.sub : []).map((s) => ({
      label: s.label + (s.external ? "  ↗" : ""),
      arrow: s.arrow,
      go: s.go,
      style: "display:flex; align-items:center; justify-content:space-between; gap:14px; text-align:left; border:0; background:transparent; padding:9px 24px; font-size:15px; font-weight:500; color:#ffffff; cursor:pointer;"
    }));
    const hasSub = subItems.length > 0;

    const isRefunds = cur.id.endsWith("/refunds");

    return {
      iaView: !!this.state.ia,
      normalView: !this.state.ia,
      setIaView: () => this.setState({ ia: true }),
      setNormalView: () => this.setState({ ia: false }),
      iaBtnStyle: "border:0; background:" + (this.state.ia ? "#000000" : "#ffffff") + "; color:" + (this.state.ia ? "#ffffff" : "#3F3F3F") + "; padding:8px 13px; font-size:11.5px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; cursor:pointer;",
      normalBtnStyle: "border:0; border-left:2px solid #000000; background:" + (this.state.ia ? "#ffffff" : "#000000") + "; color:" + (this.state.ia ? "#3F3F3F" : "#ffffff") + "; padding:8px 13px; font-size:11.5px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; cursor:pointer;",
      shellStyle: "min-height:100vh; display:flex; flex-direction:column; background:#ffffff;" + (this.state.ia ? " filter:grayscale(1) contrast(0.82) brightness(1.08);" : ""),
      showTaskStrip: this.props.showTaskStrip !== false,
      showAnnotations: this.props.showAnnotations !== false,
      clicks: this.state.clicks,
      reset: () => this.setState({ id: null, clicks: 0, submitted: false, menuOpen: false, hovered: null }),
      menuOpen: this.state.menuOpen,
      menuClosed: !this.state.menuOpen,
      menuBtnStyle: "display:flex; align-items:center; gap:11px; border:2px solid #ffffff; background:" + (this.state.menuOpen ? "#9C11F0" : "transparent") + "; padding:9px 14px; font-size:12.5px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#ffffff; cursor:pointer;",
      toggleMenu: () => this.setState((s) => ({ menuOpen: !s.menuOpen, hovered: null })),
      clearHover: () => this.setState({ hovered: null }),
      menuGrid: "position:relative; z-index:4; display:grid; grid-template-columns:280px 350px " + (hasSub ? "minmax(320px, 1fr)" : "0") + "; min-height:520px; overflow:hidden; border-bottom:4px solid #000000;",
      quickLinks, menuCats, subItems, hasSub,
      hoveredLabel: hovered ? hovered.label : "",
      isHome,
      isInterior: !isHome,
      goHome: this.nav("home"),
      goAdmissions: this.nav("admissions"),
      goMyOcadu: this.nav("campus-life/myocadu"),
      videoState: this.state.playing ? "playing" : "paused",
      toggleVideo: () => this.setState((s) => ({ playing: !s.playing })),
      videoBtnStyle: "position:absolute; right:40px; bottom:40px; display:flex; align-items:center; gap:9px; border:2px solid #000000; background:#ffffff; padding:16px 20px; cursor:pointer;",
      playGlyphStyle: "font-size:26px; line-height:1; color:" + (this.state.playing ? "#000000" : "#C9C9C9") + ";",
      pauseGlyphStyle: "display:flex; gap:6px; color:" + (this.state.playing ? "#C9C9C9" : "#000000") + ";",
      promos: [
        { title: "Undergraduate Admissions", sub: "Programs, portfolios and how to apply.", go: this.nav("admissions/undergraduate-admissions"),
          slotId: "home-card-admissions", slotHint: "Drop a studio / student-work photo",
          band: "display:flex; flex-direction:column; gap:10px; padding:22px 24px 26px; background:#9C11F0; color:#ffffff;" },
        { title: "Events and Exhibitions", sub: "What's on across the campus this term.", go: this.nav("campus-life/events-and-exhibitions"),
          slotId: "home-card-events", slotHint: "Drop an exhibition photo",
          band: "display:flex; flex-direction:column; gap:10px; padding:22px 24px 26px; background:#EEF84E; color:#000000;" }
      ],
      refundTiles: ["Return a tuition overpayment","Refund after course withdrawal","Return laptop program equipment","Return a deposit or other fee"].map((label, i) => ({
        label,
        style: "background:" + ACCENTS[i] + "; color:" + (ACCENTS[i] === "#EEF84E" ? "#000000" : "#ffffff") + "; padding:24px 22px; min-height:120px; font-size:17px; font-weight:700; line-height:1.25;"
      })),
      helpful: [
        this.item("my.OCADU.ca", "campus-life/myocadu", true),
        this.item("Admissions", "admissions"),
        this.item("Events & Exhibitions", "campus-life/events-and-exhibitions"),
        this.item("Accessibility", "student-services/student-accessibility-services"),
        this.item("Contact", "admissions/undergraduate-admissions/get-help/contact-us"),
        this.item("Campus Map", "campus-life/our-campus", true),
        this.item("Give Now", "student-services/financial-aid")
      ],
      sectionLabel: NODES[cur.section].label,
      crumbs, sideNav,
      title: cur.label,
      pathText: chain.map((n) => n.label).join("  /  "),
      kids: cur.children.map((id) => this.item(null, id)),
      hasKids: cur.children.length > 0,
      isPlainLeaf: cur.children.length === 0 && !isRefunds,
      isRefunds,
      submitted: this.state.submitted,
      submit: () => this.setState({ submitted: true }),
      goStudentAccounts: this.nav("student-services/student-accounts")
    };
  }
}
</script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<style>
  html, body { margin:0; padding:0; background:#eeeeec; }
  body { font-family: Helvetica, "Helvetica Neue", Arial, sans-serif; color:#2e2e2b; -webkit-font-smoothing:antialiased; }
  button { font-family: inherit; }
  a { color:#2e2e2b; text-decoration: underline; }
  a:hover { color:#000; }
  @keyframes dcFade { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:none; } }
</style>
</helmet>
<div style="min-height:100vh; display:flex; flex-direction:column; background:#eeeeec;">

  <sc-if value="{{ showTaskStrip }}" hint-placeholder-val="{{ true }}">
    <div style="display:flex; align-items:center; gap:16px; padding:10px 28px; background:#3a3a37; color:#f4f4f1; font-family:ui-monospace, Menlo, monospace; font-size:12px; letter-spacing:0.04em;">
      <span style="border:1px solid #8d8d86; padding:2px 7px;">TASK</span>
      <span>“I want to send something back.”</span>
      <span style="margin-left:auto; opacity:0.7;">clicks: {{ clicks }}</span>
      <button onClick="{{ reset }}" style="background:transparent; color:#f4f4f1; border:1px solid #8d8d86; padding:3px 9px; font-family:ui-monospace, Menlo, monospace; font-size:12px; cursor:pointer;">reset</button>
    </div>
  </sc-if>

  <header style="background:#fbfbf9; border-bottom:1px solid #c9c9c3; padding:0 28px; position:relative; z-index:5;">
    <div style="display:flex; align-items:center; gap:24px; padding:18px 0 16px;">
      <button onClick="{{ goHome }}" style="border:0; background:transparent; padding:0; cursor:pointer;">
        <div style="position:relative; width:92px; height:74px;">
          <div style="position:absolute; top:0; left:0; width:60px; height:52px; border:2px solid #2e2e2b; display:grid; grid-template-columns:1fr 1fr; place-items:center; font-size:15px; font-weight:700; letter-spacing:0.04em; color:#2e2e2b; padding:3px 5px; box-sizing:border-box;">
            <span>O</span><span>C</span><span>A</span><span>D</span>
          </div>
          <div style="position:absolute; top:38px; left:48px; width:34px; height:34px; border:2px solid #2e2e2b; background:#fbfbf9; display:grid; place-items:center; font-size:15px; font-weight:700; color:#2e2e2b;">U</div>
        </div>
      </button>
      <div style="margin-left:auto; display:flex; align-items:center; gap:10px;">
        <button style="display:flex; align-items:center; gap:12px; border:1px solid #4a4a45; background:#fbfbf9; padding:9px 14px; font-size:14px; letter-spacing:0.08em; text-transform:uppercase; color:#2e2e2b; cursor:pointer;" style-hover="background:#e7e7e1;">
          <span>Search</span>
          <span style="position:relative; display:block; width:15px; height:15px; border:2px solid #3a3a37; border-radius:50%;">
            <span style="position:absolute; top:13px; left:12px; display:block; width:2px; height:7px; background:#3a3a37; transform:rotate(-45deg);"></span>
          </span>
        </button>
        <button onClick="{{ toggleMenu }}" style="display:flex; align-items:center; gap:12px; border:1px solid #4a4a45; background:#fbfbf9; padding:9px 14px; font-size:14px; letter-spacing:0.08em; text-transform:uppercase; color:#2e2e2b; cursor:pointer;" style-hover="background:#e7e7e1;">
          <span>Menu</span>
          <sc-if value="{{ menuOpen }}" hint-placeholder-val="{{ false }}">
            <span style="font-size:16px; line-height:1;">✕</span>
          </sc-if>
          <sc-if value="{{ menuClosed }}" hint-placeholder-val="{{ true }}">
            <span style="display:flex; flex-direction:column; gap:3px;">
              <span style="display:block; width:18px; height:2px; background:#3a3a37;"></span>
              <span style="display:block; width:18px; height:2px; background:#3a3a37;"></span>
              <span style="display:block; width:18px; height:2px; background:#3a3a37;"></span>
            </span>
          </sc-if>
        </button>
      </div>
    </div>
    <div style="display:flex; justify-content:flex-end; padding:0 0 14px;">
      <button onClick="{{ goMyOcadu }}" style="display:flex; align-items:stretch; border:1px solid #4a4a45; background:#f2f2ee; padding:0; font-size:12px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#2e2e2b; cursor:pointer;" style-hover="background:#e4e4de;">
        <span style="padding:8px 14px;">Log in to my OCADU</span>
        <span style="display:grid; place-items:center; width:32px; background:#3a3a37; color:#f7f7f4; font-size:13px;">→</span>
      </button>
    </div>
    <sc-if value="{{ showTopNav }}" hint-placeholder-val="{{ false }}">
      <nav style="display:flex; gap:4px;">
        <sc-for list="{{ topNav }}" as="item" hint-placeholder-count="4">
          <button onClick="{{ item.go }}" style="{{ item.style }}" style-hover="background:#e4e4de;">{{ item.label }}</button>
        </sc-for>
      </nav>
    </sc-if>
  </header>

  <sc-if value="{{ menuOpen }}" hint-placeholder-val="{{ false }}">
    <div onMouseLeave="{{ clearHover }}" style="{{ menuGrid }}">
      <div style="background:#262623; padding:26px 22px 40px; display:flex; flex-direction:column; gap:2px; animation:dcFade 140ms ease-out;">
        <sc-for list="{{ quickLinks }}" as="q" hint-placeholder-count="7">
          <button onClick="{{ q.go }}" style="{{ q.style }}" style-hover="background:#3d3d38;">
            <span>{{ q.label }}</span>
            <sc-if value="{{ q.external }}" hint-placeholder-val="{{ false }}">
              <span style="font-size:11px; opacity:0.8;">↗</span>
            </sc-if>
          </button>
        </sc-for>
      </div>

      <div style="background:#fbfbf9; border-right:1px solid #c9c9c3; padding:26px 0 40px; display:flex; flex-direction:column; animation:dcFade 200ms ease-out 60ms both;">
        <sc-for list="{{ menuCats }}" as="cat" hint-placeholder-count="13">
          <button onClick="{{ cat.go }}" onMouseEnter="{{ cat.hover }}" onFocus="{{ cat.hover }}" style="{{ cat.style }}">
            <span>{{ cat.label }}</span>
            <sc-if value="{{ cat.arrow }}" hint-placeholder-val="{{ true }}">
              <span style="color:#6f6f68;">›</span>
            </sc-if>
          </button>
        </sc-for>
      </div>

      <sc-if value="{{ hasSub }}" hint-placeholder-val="{{ false }}">
        <div style="background:#cfcfc8; padding:26px 0 40px; display:flex; flex-direction:column; animation:dcFade 160ms ease-out;">
          <div style="padding:0 24px 12px; font-family:ui-monospace, Menlo, monospace; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#5c5c56;">{{ hoveredLabel }}</div>
          <sc-for list="{{ subItems }}" as="s" hint-placeholder-count="6">
            <button onClick="{{ s.go }}" style="{{ s.style }}" style-hover="background:#dededa;">
              <span>{{ s.label }}</span>
              <sc-if value="{{ s.arrow }}" hint-placeholder-val="{{ false }}">
                <span style="color:#5c5c56;">›</span>
              </sc-if>
            </button>
          </sc-for>
        </div>
      </sc-if>
    </div>
  </sc-if>

  <sc-if value="{{ isHome }}" hint-placeholder-val="{{ true }}">
    <main style="flex:1;">
      <section style="border-bottom:1px solid #c9c9c3; background:#e2e2dc; height:560px; position:relative;">
        <svg width="100%" height="100%" viewBox="0 0 1200 560" preserveAspectRatio="none" style="position:absolute; inset:0;">
          <line x1="0" y1="0" x2="1200" y2="560" stroke="#cfcfc8" stroke-width="1"></line>
          <line x1="1200" y1="0" x2="0" y2="560" stroke="#cfcfc8" stroke-width="1"></line>
        </svg>
        <div style="position:absolute; top:22px; left:28px; font-family:ui-monospace, Menlo, monospace; font-size:12px; letter-spacing:0.2em; color:#6f6f68;">VIDEO — {{ videoState }}</div>
        <button onClick="{{ toggleVideo }}" style="{{ videoBtnStyle }}" style-hover="background:#fbfbf9;">
          <span style="{{ playGlyphStyle }}">▶</span>
          <span style="{{ pauseGlyphStyle }}">
            <span style="display:block; width:5px; height:22px; background:currentColor;"></span>
            <span style="display:block; width:5px; height:22px; background:currentColor;"></span>
          </span>
        </button>
      </section>

